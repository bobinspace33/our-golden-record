{
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=$1" },
    { "source": "/document/(.*)", "destination": "/api?__path=document/$1" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{documents/**,public/Community-personas.csv,public/globe_icon.png,public/rubrics/**,public/project briefs/**}"
    }
  }
}
